# Environment variables (NEVER commit these!)
.env
.env.local
.env.production

# Local config overrides (committed template: config/config.local.yaml.example)
config/config.local.yaml

# Google Cloud credentials (CRITICAL - never commit!)
*.json
service-account-*.json
gcs-key.json
credentials.json
*-credentials.json
*-key.json

# Downloaded content
downloads/
*.mp3
*.mp4
*.wav
*.m4a

# Data — keep the folder layout (.gitkeep + READMEs), ignore actual datasets
data/**
!data/**/
!data/README.md
!data/**/.gitkeep

# Logs
*.log
.download_log.json
downloader.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# Packaging / build artifacts
*.egg-info/
*.egg
build/
dist/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

